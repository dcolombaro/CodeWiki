# Copy this file to .env.local, fill the approved model settings, and chmod 600 it.
# .env.local is Git-ignored. Never commit the key.
CUSTOMER_MODEL_API_KEY=''
CUSTOMER_MODEL_BASE_URL=''
CUSTOMER_MODEL_ID=''
PEGA_PROJECT_ID=''
PEGA_RELEASE='lead'
# Optional focused request for scripts/pega_wiki_demo.sh. Leave both seeds empty for the whole project.
PEGA_SEED_ID=''
PEGA_SEED_NAME=''
PEGA_DEPTH=''
# Optional style for scripts/pega_wiki_demo.sh: api, architecture, user-guide,
# developer, or functional. Functional favors business behavior and decisions.
PEGA_DOC_TYPE=''
# Optional reader/audience instruction, e.g. 'Write for business analysts'.
PEGA_INSTRUCTIONS=''
# Optional manual snapshot replay is available through the CLI; normal generation checks the live KB.
PEGA_SNAPSHOT_DIR=''
# Optional: path to a validated plan for this exact snapshot.
PEGA_PLAN_FILE=''
# Bundle root and Python for the new release-scoped pega_kb.mcp_server.
PEGA_KB_ROOT=''
PEGA_PYTHON=''
# Optional: select the fork's installed CLI and default chat-run location.
CODEWIKI_BIN=''
CODEWIKI_PEGA_OUTPUT_ROOT='runs/chat-generated'
# Persistent evidence/component cache for the automatic PEGA workflow.
CODEWIKI_PEGA_CACHE_DIR='runs/.codewiki-pega-cache'
# Optional JSON argv override; defaults to ["-m", "pega_kb.mcp_server"].
PEGA_MCP_ARGS_JSON='["-m", "pega_kb.mcp_server"]'
